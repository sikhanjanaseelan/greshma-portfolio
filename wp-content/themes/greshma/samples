/* =========================================
   PATHS SECTION
========================================= */

.paths-section {
    position: relative;
    padding: 120px 0;
    background: #f7f3e9;
    color: #17352e;
    overflow: hidden;
}

.paths-heading {
    margin-bottom: 58px;
}

.paths-heading__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
    color: #7c8765;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
}

.paths-heading__line {
    display: block;
    width: 42px;
    height: 1px;
    background: #c9a85d;
}

.paths-heading__content {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    align-items: end;
    gap: 60px;
}

.paths-heading__title {
    max-width: 760px;
    margin: 0;
    color: #17352e;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(52px, 5vw, 82px);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
}

.paths-heading__title em {
    display: block;
    color: #8e986e;
    font-weight: 500;
}

.paths-heading__description {
    max-width: 490px;
    margin: 0;
    color: #5b6b63;
    font-size: 17px;
    line-height: 1.8;
}

.paths-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.path-card {
    position: relative;
    min-height: 390px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
    border: 1px solid rgba(23, 53, 46, 0.1);
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.68);
    box-shadow: 0 18px 45px rgba(24, 50, 43, 0.07);
    overflow: hidden;
    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        background-color 0.3s ease;
}

.path-card::before {
    content: "";
    position: absolute;
    inset: auto -60px -80px auto;
    width: 170px;
    height: 170px;
    border-radius: 50%;
    background: rgba(142, 152, 110, 0.1);
    transition: transform 0.35s ease;
}

.path-card:hover {
    transform: translateY(-8px);
    background: #ffffff;
    box-shadow: 0 26px 60px rgba(24, 50, 43, 0.12);
}

.path-card:hover::before {
    transform: scale(1.2);
}

.path-card__top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.path-card__number {
    color: #a59d81;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
}

.path-card__arrow {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #173f35;
    background: #f1ead7;
    font-size: 19px;
    transition:
        transform 0.3s ease,
        background-color 0.3s ease,
        color 0.3s ease;
}

.path-card:hover .path-card__arrow {
    color: #ffffff;
    background: #173f35;
    transform: rotate(45deg);
}

.path-card__content {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 90px;
}

.path-card__title {
    margin: 0 0 16px;
    color: #17352e;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 31px;
    font-weight: 500;
    line-height: 1.15;
}

.path-card__description {
    margin: 0;
    color: #64716a;
    font-size: 15px;
    line-height: 1.75;
}

.path-card__link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    color: #173f35;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
}

.path-card__link span {
    transition: transform 0.25s ease;
}

.path-card__link:hover span {
    transform: translateX(5px);
}

@media (max-width: 1100px) {
    .paths-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .paths-heading__content {
        grid-template-columns: 1fr;
        gap: 24px;
    }
}

@media (max-width: 640px) {
    .paths-section {
        padding: 80px 0;
    }

    .paths-heading {
        margin-bottom: 38px;
    }

    .paths-heading__title {
        font-size: clamp(44px, 12vw, 62px);
    }

    .paths-heading__description {
        font-size: 16px;
    }

    .paths-grid {
        grid-template-columns: 1fr;
    }

    .path-card {
        min-height: 330px;
        padding: 24px;
    }

    .path-card__content {
        padding-top: 60px;
    }
}
